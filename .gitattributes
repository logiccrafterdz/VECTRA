# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Explicit C/C++/text sources -> LF in repository
*.c    text
*.cc   text
*.cpp  text
*.cxx  text
*.h    text
*.hh   text
*.hpp  text
*.hxx  text
*.txt  text
*.md   text
*.json text
*.py   text

# Windows batch files must keep CRLF to run correctly
*.bat  text eol=crlf

# Shell scripts must keep LF
*.sh   text eol=lf

# Binary assets: never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.pptx binary
*.docx binary
